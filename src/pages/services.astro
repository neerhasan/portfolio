---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteData } from '../content/site-data.js';
---
<BaseLayout title="Services" description="Services offered by Neer Hasan - Graphic Design, UI/UX, Web Development, Brand Identity">
  <section style="padding-top: 4rem;">
    <div class="container">
      <header class="section-header">
        <h1>Services</h1>
        <p>Comprehensive design and development solutions tailored to your needs</p>
      </header>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="services-grid">
        {siteData.services.map((service, index) => (
          <article class="service-card">
            <div class="service-icon" aria-hidden="true">
              {[
                '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>',
                '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6"/><path d="M12 15h4"/></svg>',
                '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>',
                '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>'
              ][index]}
            </div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section style="background: #f8f8fc;">
    <div class="container">
      <header class="section-header">
        <h2>Process</h2>
        <p>How we'll work together to deliver exceptional results</p>
      </header>
      <div class="card-grid">
        <article class="card">
          <h3>1. Discovery</h3>
          <p>Understanding your goals, audience, and requirements through detailed conversations and research.</p>
        </article>
        <article class="card">
          <h3>2. Strategy</h3>
          <p>Developing a clear roadmap with timelines, deliverables, and success metrics aligned to your objectives.</p>
        </article>
        <article class="card">
          <h3>3. Design & Build</h3>
          <p>Iterative creation with regular check-ins, ensuring the work evolves in the right direction.</p>
        </article>
        <article class="card">
          <h3>4. Launch & Support</h3>
          <p>Smooth deployment followed by ongoing support and optimization based on real-world feedback.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="contact-cta" style="background: #1a1a2e; color: #fff; text-align: center;">
    <div class="container">
      <h2>Need Something Custom?</h2>
      <p style="color: #c0c0e0; max-width: 600px; margin: 1rem auto 2rem;">Don't see exactly what you're looking for? Let's discuss your specific needs.</p>
      <a href="/contact" class="btn btn-primary" style="background: #fff; color: #1a1a2e;">Start a Conversation</a>
    </div>
  </section>
</BaseLayout>