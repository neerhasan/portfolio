---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteData } from '../content/site-data.js';
---
<BaseLayout title="Home" description={siteData.tagline}>
  <section class="hero">
    <div class="container">
      <h1>{siteData.name}</h1>
      <p class="tagline">{siteData.tagline}</p>
      <p style="max-width: 700px; margin: 0 auto 2rem; font-size: 1.125rem;">{siteData.about}</p>
      <div class="cta-group">
        <a href="/services" class="btn btn-primary">View Services</a>
        <a href="/contact" class="btn btn-secondary">Get In Touch</a>
      </div>
    </div>
  </section>

  <section id="services-preview" aria-labelledby="services-preview-heading">
    <div class="container">
      <header class="section-header">
        <h2 id="services-preview-heading">Services</h2>
        <p>What I offer to help bring your ideas to life</p>
      </header>
      <div class="card-grid">
        {siteData.services.slice(0, 3).map(service => (
          <article class="card">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </article>
        ))}
      </div>
      <div style="text-align: center; margin-top: 2rem;">
        <a href="/services" class="btn btn-secondary">View All Services</a>
      </div>
    </div>
  </section>

  <section id="featured-work" aria-labelledby="featured-work-heading">
    <div class="container">
      <header class="section-header">
        <h2 id="featured-work-heading">Featured Work</h2>
        <p>Selected projects from my portfolio</p>
      </header>
      <div class="projects-grid">
        {siteData.projects.map(project => (
          <article class="project-card">
            <div class="project-image">
              <span>{project.category}</span>
            </div>
            <div class="project-content">
              <span class="project-category">{project.category}</span>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <a href={project.link} target="_blank" rel="noopener noreferrer" class="project-link">
                View Project →
              </a>
            </div>
          </article>
        ))}
      </div>
      <div style="text-align: center; margin-top: 2rem;">
        <a href="https://behance.net/neerhasan" target="_blank" rel="noopener noreferrer" class="btn btn-primary">View More on Behance</a>
      </div>
    </div>
  </section>

  <section id="contact-cta" style="background: #1a1a2e; color: #fff; text-align: center;">
    <div class="container">
      <h2>Ready to Start a Project?</h2>
      <p style="color: #c0c0e0; max-width: 600px; margin: 1rem auto 2rem;">Let's collaborate and create something great together.</p>
      <a href="/contact" class="btn btn-primary" style="background: #fff; color: #1a1a2e;">Get In Touch</a>
    </div>
  </section>
</BaseLayout>