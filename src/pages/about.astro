---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteData } from '../content/site-data.js';
---
<BaseLayout title="About" description="Learn more about Neer Hasan - Designer & Developer">
  <section style="padding-top: 4rem;">
    <div class="container">
      <div class="about-content">
        <div class="about-text">
          <h2>About Me</h2>
          <p>{siteData.about}</p>
          <p>I believe that great design solves problems and great code brings those solutions to life. My approach combines strategic thinking with attention to detail, ensuring every project not only looks great but performs exceptionally.</p>
          <p>When I'm not designing or coding, you'll find me exploring new design trends, contributing to open source, or sharing knowledge with the design community.</p>

          <h3 style="margin-top: 2.5rem;">Skills & Tools</h3>
          <div class="skills-list">
            {siteData.skills.map(skill => (
              <span class="skill-tag">{skill}</span>
            ))}
          </div>
        </div>
        <div class="about-image">
          <span>Profile Image Placeholder</span>
        </div>
      </div>
    </div>
  </section>

  <section style="background: #f8f8fc;">
    <div class="container">
      <header class="section-header">
        <h2>Experience</h2>
      </header>
      <div class="card-grid">
        <article class="card">
          <h3>Senior Designer & Developer</h3>
          <p style="color: #2563eb; font-weight: 600; margin-bottom: 0.5rem;">2022 — Present</p>
          <p>Leading design and development for client projects across various industries. Specializing in brand identity, UI/UX, and modern web development.</p>
        </article>
        <article class="card">
          <h3>Freelance Designer</h3>
          <p style="color: #2563eb; font-weight: 600; margin-bottom: 0.5rem;">2019 — 2022</p>
          <p>Worked with startups and established brands on visual identity, marketing materials, and digital experiences. Built a diverse portfolio on Behance.</p>
        </article>
        <article class="card">
          <h3>Junior Graphic Designer</h3>
          <p style="color: #2563eb; font-weight: 600; margin-bottom: 0.5rem;">2017 — 2019</p>
          <p>Started career in a creative agency environment. Gained hands-on experience with print design, brand guidelines, and client communication.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="contact-cta" style="background: #1a1a2e; color: #fff; text-align: center;">
    <div class="container">
      <h2>Let's Work Together</h2>
      <p style="color: #c0c0e0; max-width: 600px; margin: 1rem auto 2rem;">Have a project in mind? I'd love to hear about it.</p>
      <a href="/contact" class="btn btn-primary" style="background: #fff; color: #1a1a2e;">Get In Touch</a>
    </div>
  </section>
</BaseLayout>